    <info>
        <name>Arturia MiniLab mkII</name>
        <author>Cutlab</author>
        <description>DJ mapping for the factory memory 1 of the Arturia MiniLab mkII. Top knobs: deck 1, bottom knobs: deck 2 (filter, high, mid, low, volume, drums, bass, vocals). Pads 1-8: hot cues of deck 1, pads 9-16 (Pad 1-8/9-16 button): hot cues of deck 2. Mod strip: crossfader.</description>
        <manual>arturia_minilab_mkii</manual>
    </info>
    <settings>
        <group label="Knobs">
            <option variable="knobMode" type="enum" label="Knob mode">
                <value label="Relative (factory memory 1)" default="true">relative</value>
                <value label="Absolute (0-127)">absolute</value>
            </option>
            <option variable="padMode" type="enum" label="Pads">
                <value label="Hot cues" default="true">hotcue</value>
                <value label="Stems: mute drums, bass, other, vocals (pads 1-4 and 5-8 per deck)">stems</value>
                <value label="Samplers 1-16">sampler</value>
            </option>
        </group>
    </settings>
